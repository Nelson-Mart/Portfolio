  <script>
    async function updateLeetCodeStats() {
    try {
      const res = await fetch(
        'https://leetcode-stats.tashif.codes/nelsonLeetcoding'
      )

      if (!res.ok) {
        throw new Error(`LeetCode API returned ${res.status}`)
      }

      const data = await res.json()

      const total = document.getElementById('lc-total')
      const easy = document.getElementById('lc-easy')
      const medium = document.getElementById('lc-medium')
      const hard = document.getElementById('lc-hard')
      const ranking = document.getElementById('lc-ranking')

      if (total) total.textContent = data.totalSolved ?? '—'
      if (easy) easy.textContent = data.easySolved ?? '—'
      if (medium) medium.textContent = data.mediumSolved ?? '—'
      if (hard) hard.textContent = data.hardSolved ?? '—'
      if (ranking) {
        ranking.textContent =
          data.ranking?.toLocaleString() ?? '—'
      }
    } catch (error) {
      console.error('Failed to fetch latest LeetCode stats:', error)
    }
  }

  updateLeetCodeStats()

    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(card => {
      card.addEventListener('mousemove', (e: MouseEvent) => {
        const r = card.getBoundingClientRect()
        const x = e.clientX - r.left
        const y = e.clientY - r.top
        const rotX = ((y - r.height / 2) / (r.height / 2)) * -8
        const rotY = ((x - r.width / 2) / (r.width / 2)) * 8
        card.style.transform = `perspective(600px) rotateX(${rotX}deg) rotateY(${rotY}deg) scale(1.02)`
        card.style.setProperty('--mx', (x / r.width * 100) + '%')
        card.style.setProperty('--my', (y / r.height * 100) + '%')
      })
      card.addEventListener('mouseleave', () => {
        card.style.transform = ''
      })
    })

    const mv = document.getElementById('gradCap') as HTMLElement & { cameraOrbit: string };
  
    const baseAzimuth = 0;
    const basePolar = 75;
    const maxSwing = 25;
  
    let targetAz = baseAzimuth;
    let targetPolar = basePolar;
    let currentAz = baseAzimuth;
    let currentPolar = basePolar;
  
    window.addEventListener('mousemove', (e) => {
      const nx = (e.clientX / window.innerWidth) * 2 - 1;
      const ny = (e.clientY / window.innerHeight) * 2 - 1;
      targetAz = baseAzimuth - nx * maxSwing;
      targetPolar = basePolar - ny * maxSwing;
    });
  
    function animate() {
      currentAz += (targetAz - currentAz) * 0.08;
      currentPolar += (targetPolar - currentPolar) * 0.08;
      mv.cameraOrbit = `${currentAz}deg ${currentPolar}deg 105%`;
      requestAnimationFrame(animate);
    }
    animate();
  </script>
